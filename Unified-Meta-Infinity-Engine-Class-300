// Unified-System-Sovereign-Meta-Infinity-Engine-Class-300.ts

export type SovereignInfinityState = {
  organismId: string;
  infinitySeed: string;                      // deterministic infinity seed
  infinityVector: ReadonlyArray<number>;     // structured infinity representation
  revision: number;
  infinityHash: string;
  lastUpdatedAt: string;
};

export type SovereignInfinityEvent =
  | { type: 'INFINITY_SEED_UPDATED'; seed: string }
  | { type: 'INFINITY_VECTOR_UPDATED'; vector: ReadonlyArray<number> }
  | { type: 'INFINITY_REVISION_INCREMENTED' };

export interface SovereignInfinityPersistence {
  loadInfinityState(organismId: string): Promise<SovereignInfinityState | null>;
  saveInfinityState(state: SovereignInfinityState): Promise<void>;
}

export class SovereignMetaInfinityEngineClass300 {
  constructor(
    private readonly persistence: SovereignInfinityPersistence,
  ) {}

  async initializeInfinity(
    organismId: string,
    initialSeed: string,
  ): Promise<SovereignInfinityState> {
    const existing = await this.persistence.loadInfinityState(organismId);
    if (existing) return existing;

    const initialVector = [8, 5, 4]; // deterministic infinity seed vector

    const initial: SovereignInfinityState = {
      organismId,
      infinitySeed: initialSeed,
      infinityVector: initialVector,
      revision: 1,
      infinityHash: this.computeInfinityHash(initialSeed, initialVector, 1),
      lastUpdatedAt: new Date().toISOString(),
    };

    await this.persistence.saveInfinityState(initial);
    return initial;
  }

  async applyEvent(
    state: SovereignInfinityState,
    event: SovereignInfinityEvent,
  ): Promise<SovereignInfinityState> {
    switch (event.type) {
      case 'INFINITY_SEED_UPDATED': {
        const nextSeed = event.seed;
        const next: SovereignInfinityState = {
          ...state,
          infinitySeed: nextSeed,
          infinityHash: this.computeInfinityHash(nextSeed, state.infinityVector, state.revision),
          lastUpdatedAt: new Date().toISOString(),
        };
        await this.persistence.saveInfinityState(next);
        return next;
      }

      case 'INFINITY_VECTOR_UPDATED': {
        const nextVector = [...event.vector];
        const next: SovereignInfinityState = {
          ...state,
          infinityVector: nextVector,
          infinityHash: this.computeInfinityHash(state.infinitySeed, nextVector, state.revision),
          lastUpdatedAt: new Date().toISOString(),
        };
        await this.persistence.saveInfinityState(next);
        return next;
      }

      case 'INFINITY_REVISION_INCREMENTED': {
        const nextRevision = state.revision + 1;
        const next: SovereignInfinityState = {
          ...state,
          revision: nextRevision,
          infinityHash: this.computeInfinityHash(
            state.infinitySeed,
            state.infinityVector,
            nextRevision,
          ),
          lastUpdatedAt: new Date().toISOString(),
        };
        await this.persistence.saveInfinityState(next);
        return next;
      }

      default:
        return state;
    }
  }

  private computeInfinityHash(
    seed: string,
    vector: ReadonlyArray<number>,
    revision: number,
  ): string {
    const input = `${seed}|${vector.join(',')}|${revision}`;
    let hash = 0;
    for (let i = 0; i < input.length; i++) {
      const chr = input.charCodeAt(i);
      hash = (hash << 5) - hash + chr;
      hash |= 0;
    }
    return `INFINITY-${hash}`;
  }
}
